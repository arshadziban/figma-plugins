{
  "name": "psd2fig",
  "version": "0.1.0",
  "private": true,
  "description": "Figma plugin: imports a PSD as editable Figma layers (text, shapes, groups, effects), with smart objects converted to shapes",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "ag-psd": "^28.0.0"
  }
}
