{
  "name": "pdfmerge",
  "version": "0.1.0",
  "private": true,
  "description": "Figma plugin: merge selected frames into one multi-page PDF with a custom file name",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
